# Folder watcher (npm run watch:transcribe). Copy to .env and fill in.

# Required, absolute paths. The service does not start without them.
WATCH_DIR=/absolute/path/to/screenreader/videos
OUTPUT_DIR=/absolute/path/to/save/transcripts

# Optional. With HF_TOKEN, audio slices go to Hugging Face for transcription (falls back to the
# on-device model on any failure) and the finished text is sent for AI cleanup.
HF_TOKEN=
# Optional. AI cleanup via OpenRouter (fallback when HF cleanup fails, or alone).
OPENROUTER_TOKEN=

# Optional. Models for the AI cleanup, tried in this order until one answers (comma separated,
# org/model[:provider]). Empty = the built-in list. Changing them needs a restart.
HF_POLISH_MODELS=
OPENROUTER_POLISH_MODELS=

# Optional. Loopback port that keeps a second copy of the service from starting (1024-65535).
INSTANCE_PORT=

# Optional. Use a system ffmpeg instead of the bundled ffmpeg-static binary.
FFMPEG_PATH=
