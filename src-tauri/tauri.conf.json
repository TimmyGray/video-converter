{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoForge",
  "version": "0.1.0",
  "identifier": "com.timmygray.videoforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop:web",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "VideoForge",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
