{
  "name": "video-converter",
  "version": "1.4.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prepare:ffmpeg-assets && next build",
    "build:desktop:web": "cross-env NEXT_OUTPUT_MODE=export npm run build",
    "start": "next start",
    "start:browser": "node scripts/open-browser.mjs .next/standalone/server.js",
    "release:build": "npm run build && node scripts/create-release.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare:ffmpeg-assets": "node scripts/prepare-ffmpeg-assets.mjs",
    "lint": "eslint",
    "test": "jest",
    "test:ci": "jest --ci"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/core-mt": "0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@huggingface/transformers": "^4.2.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/material-nextjs": "^9.0.0",
    "@tauri-apps/api": "^2.10.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
